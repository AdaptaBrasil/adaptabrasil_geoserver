# Copie este arquivo para .env e preencha os valores.
# O .env não vai para o Git; este exemplo vai, sem senhas.

# PostgreSQL
ADAPTABRASIL_DB_HOST=3.224.52.81
ADAPTABRASIL_DB_PORT=6543
ADAPTABRASIL_DB_NAME=adaptabrasil
ADAPTABRASIL_DB_USER=adaptabrasil_user
ADAPTABRASIL_DB_PASSWORD=
ADAPTABRASIL_DB_SCHEMA=adaptabrasil_aluana

# GeoServer (no servidor AWS, o configurar_geoserver.py roda em localhost:8081)
ADAPTABRASIL_GEOSERVER_URL=http://localhost:8081/geoserver
ADAPTABRASIL_GEOSERVER_USER=admin
ADAPTABRASIL_GEOSERVER_PASSWORD=
ADAPTABRASIL_GEOSERVER_WORKSPACE=adaptabrasil
ADAPTABRASIL_GEOSERVER_DATASTORE=adaptabrasil
# URL pública do GeoServer, usada pelo navegador para carregar os mapas (WMS)
ADAPTABRASIL_GEOSERVER_PUBLIC_URL=http://3.224.52.81:8080/geoserver
# Nome da layer parametrizada (SQL view) criada pelo scripts/configurar_geoserver.py
ADAPTABRASIL_GEOSERVER_LAYER=indicador
